package: "com.android.intentresolver"
container: "system"

# name: [a-z0-9][_a-z0-9]+
# namespace: intentresolver
# bug: "Feature_Bug_#" or "<none>"

flag {
  name: "desktop_ui"
  namespace: "intentresolver"
  description: "Enable desktop UI for Chooser."
  bug: "453752027"
}

flag {
  name: "refine_system_actions"
  namespace: "intentresolver"
  description: "This flag enables sending system actions to the caller refinement flow"
  bug: "331206205"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

flag {
  name: "shareousel_scroll_offscreen_selections"
  namespace: "intentresolver"
  description: "Whether to scroll items onscreen when they are partially offscreen and selected/unselected."
  bug: "351883537"
}

flag {
  name: "shareousel_selection_shrink"
  namespace: "intentresolver"
  description: "Whether to shrink Shareousel items when they are selected."
  bug: "361792274"
}

flag {
  name: "limit_target_data_loading_threads"
  namespace: "intentresolver"
  description: "Limit the number of background threads (currently 4) that can be used to load per-target resources"
  bug: "420992996"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

flag {
  name: "use_actual_preview_height"
  namespace: "intentresolver"
  description: "Use actual preview height instead of the estimated value."
  bug: "405235852"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

flag {
  name: "use_recycler_view_decorations"
  namespace: "intentresolver"
  description: "Use RecyclerView decorations to draw the app divider and footer."
  bug: "338453190"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}
