package: "com.android.intentresolver"
container: "system"

# name: [a-z0-9][_a-z0-9]+
# namespace: intentresolver
# bug: "Feature_Bug_#" or "<none>"

flag {
  name: "badge_shortcut_icon_placeholders"
  namespace: "intentresolver"
  description: "Badge shortcut icon placeholders with app icon."
  bug: "349847176"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

flag {
  name: "delay_drawer_offset_calculation"
  namespace: "intentresolver"
  description: "Do not update the drawer offset until app targets are ready."
  bug: "338229069"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

flag {
  name: "refine_system_actions"
  namespace: "intentresolver"
  description: "This flag enables sending system actions to the caller refinement flow"
  bug: "331206205"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

flag {
  name: "rebuild_adapters_on_target_pinning"
  namespace: "intentresolver"
  description: "Rebuild and swap adapters when a target gets (un)pinned to avoid flickering."
  bug: "230703572"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

flag {
  name: "target_hover_and_keyboard_focus_states"
  namespace: "intentresolver"
  description: "Adopt Launcher pointer hover and keyboard novigation focus effects for targets."
  bug: "295175912"
}

flag {
  name: "synchronous_drawer_offset_calculation"
  namespace: "intentresolver"
  description: "Calculate drawer offset synchronously"
  bug: "401566089"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

flag {
  name: "shareousel_scroll_offscreen_selections"
  namespace: "intentresolver"
  description: "Whether to scroll items onscreen when they are partially offscreen and selected/unselected."
  bug: "351883537"
}

flag {
  name: "shareousel_selection_shrink"
  namespace: "intentresolver"
  description: "Whether to shrink Shareousel items when they are selected."
  bug: "361792274"
}

flag {
  name: "use_google_sans_flex"
  namespace: "intentresolver"
  description: "Use Google Sans Flex font."
  bug: "393610034"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

flag {
  name: "launch_editor_as_current_user"
  namespace: "intentresolver"
    description: "Launch the image editor as the current user instead of always-personal"
    bug: "407991863"
    metadata {
      purpose: PURPOSE_BUGFIX
    }
}
